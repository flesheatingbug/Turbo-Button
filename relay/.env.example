# Copy to .env and adjust.
# Host folder for the relay's settings (password hash, sign-in code secret, paired phones).
APPDATA=/opt/appdata
# Port on the host (Nginx Proxy Manager forwards your domain to it).
PORT=8085
# The address people use, as set up in Nginx Proxy Manager.
PUBLIC_URL=https://turbo.example.com
# User/group that owns $APPDATA/turbo-relay (run `id` to see yours).
PUID=1000
PGID=1000
TZ=Europe/Dublin
